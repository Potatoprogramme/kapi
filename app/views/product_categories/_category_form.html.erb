<%= form_with model: @category do |form| %>
  <div>
    <%= form.label :category_name %>
    <%= form.text_field :category_name, class: "border-2 border-black" %>
  </div>
  <div>
    <%= form.label :description %>
    <%= form.text_field :description, class: "border-2 border-black" %>
  </div>
  <div>
    <%= form.label :color %>
    <%= form.text_field :color, class: "border-2 border-black" %>
  </div>
  <div>
    <%= button_to 'Save', new_product_category_path, class: "border-2 border-black p-2" %>
  </div>
<% end%>