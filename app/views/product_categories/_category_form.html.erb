<%= form_with model: @category, local: true do |form| %>
  <% if @category.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <ul>
        <% @category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, "Category Name" %>
    <%= form.text_field :name, class: "border-2 border-black" %>
  </div>
  <div>
    <%= form.label :description %>
    <%= form.text_field :description, class: "border-2 border-black" %>
  </div>
  <div>
    <%= form.label :color %>
    <%= form.color_field :color, class: "border-2 border-black" %>
  </div>
  <div>
    <%= form.submit "Save", class: "border-2 border-black p-2" %>
  </div>
<% end %>