<div id="toast" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50">
  <div class="flex flex-col items-end space-y-2">
    <% flash.each do |key, message| %>
      <% next if message.blank? %>
      <div class="flash-item flex items-center gap-3 px-4 py-3 rounded-xl text-sm max-w-xs w-full
        <%= case key.to_sym
            when :alert, :error then 'bg-red-50 border border-red-200 text-red-700'
            when :warning       then 'bg-amber-50 border border-amber-200 text-amber-700'
            when :info          then 'bg-blue-50 border border-blue-200 text-blue-700'
            else                     'bg-green-50 border border-green-200 text-green-700'
            end %>">
        <%# Icon %>
        <% if [:alert, :error].include?(key.to_sym) %>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0"><circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1.5"/><rect x="7.25" y="4" width="1.5" height="5" rx=".75" fill="currentColor"/><rect x="7.25" y="10.5" width="1.5" height="1.5" rx=".75" fill="currentColor"/></svg>
        <% elsif key.to_sym == :warning %>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0"><path d="M8 2L14.5 13.5H1.5L8 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><rect x="7.25" y="6.5" width="1.5" height="3.5" rx=".75" fill="currentColor"/><rect x="7.25" y="11" width="1.5" height="1.5" rx=".75" fill="currentColor"/></svg>
        <% else %>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0"><circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1.5"/><path d="M5 8l2.5 2.5L11 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <% end %>
        <span class="flex-1"><%= message %></span>
      </div>
    <% end %>
  </div>
</div>
<script>
  $(document).ready(function() {
    var toast = $('#toast');
    if (toast.find('.flash-item').length === 0) return;
    setTimeout(function() {
      toast.fadeOut(300, function() { toast.remove(); });
    }, 3000);
  });
</script>