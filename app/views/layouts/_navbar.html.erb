<nav class="bg-gradient-to-r from-amber-50 via-orange-50 to-yellow-50 shadow-xl backdrop-blur-xl border-b border-amber-100/50 sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center py-6">
      <!-- Coffee Logo/Brand with Steam Animation -->
      <div class="flex items-center space-x-3">
        <%= link_to root_path, class: "group flex items-center space-x-2" do %>
          <div>
            <h1 class="font-serif font-light text-4xl font-black bg-gradient-to-r from-amber-700 via-orange-700 to-red-700 bg-clip-text text-transparent group-hover:from-amber-800 group-hover:via-orange-800 group-hover:to-red-800 transition-all duration-300">
              Kapi
            </h1>
            <p class="text-xs text-amber-600 font-medium -mt-1">Coffee Collection</p>
          </div>
        <% end %>
      </div>
      <!-- Navigation Links with Coffee Theme -->
      <div class="hidden md:flex items-center space-x-2">
        <%= link_to materials_path, 
            class: "group flex items-center space-x-2 px-6 py-3 rounded-2xl font-bold transition-all duration-300 transform hover:-translate-y-1 #{'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-lg' if current_page?(materials_path)} #{'bg-white/60 backdrop-blur-sm text-amber-700 hover:bg-amber-100/80 shadow-md' unless current_page?(materials_path)}" do %>
          <div class="w-8 h-8 <%= current_page?(materials_path) ? 'bg-white/20' : 'bg-amber-100' %> rounded-xl flex items-center justify-center group-hover:rotate-12 transition-transform duration-300">
            <svg class="w-4 h-4" width="120" height="120" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8">
              <path fill="currentColor" d="M4 0C0 0 0 8 4 8s4-8 0-8m0 0C2 5 7 3 4 8c2-5-3-3 0-8"/>
            </svg>
          </div>
          <span>Coffee Beans</span>
        <% end %>
        <%= link_to products_path, 
            class: "group flex items-center space-x-2 px-6 py-3 rounded-2xl font-bold transition-all duration-300 transform hover:-translate-y-1 #{'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-lg' if current_page?(products_path)} #{'bg-white/60 backdrop-blur-sm text-amber-700 hover:bg-amber-100/80 shadow-md' unless current_page?(products_path)}" do %>
          <div class="w-8 h-8 <%= current_page?(products_path) ? 'bg-white/20' : 'bg-amber-100' %> rounded-xl flex items-center justify-center group-hover:rotate-12 transition-transform duration-300">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 11h14V8H5zm12.5 0L16 21H8L6.5 11M6 8V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1m-3-3V3"/>
            </svg>
          </div>
          <span>Coffee Menu</span>
        <% end %>
        <%= link_to product_categories_path, 
            class: "group flex items-center space-x-2 px-6 py-3 rounded-2xl font-bold transition-all duration-300 transform hover:-translate-y-1 #{'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-lg' if current_page?(product_categories_path)} #{'bg-white/60 backdrop-blur-sm text-amber-700 hover:bg-amber-100/80 shadow-md' unless current_page?(product_categories_path)}" do %>
          <div class="w-8 h-8 <%= current_page?(product_categories_path) ? 'bg-white/20' : 'bg-amber-100' %> rounded-xl flex items-center justify-center group-hover:rotate-12 transition-transform duration-300">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
            </svg>
          </div>
          <span>Maange Orders</span>
        <% end %>
        <!-- Extra Cute Coffee Actions -->
        <div class="flex items-center space-x-2 ml-4">
          <button class="group w-12 h-12 bg-gradient-to-r from-green-400 to-emerald-500 hover:from-green-500 hover:to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
          </button>
          <button class="group w-12 h-12 bg-gradient-to-r from-pink-400 to-rose-500 hover:from-pink-500 hover:to-rose-600 rounded-2xl flex items-center justify-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <svg class="w-5 h-5 text-white group-hover:scale-110 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </button>
          <% if authenticated? %>
            <%= button_to session_path, method: :delete, class: "group w-12 h-12 bg-gradient-to-r from-red-600 to-orange-700 hover:from-red-700 hover:to-red-800 rounded-2xl flex items-center justify-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>
      <!-- Mobile menu button with Coffee Theme -->
      <div class="md:hidden">
        <button id="mobile-menu-button" class="group w-12 h-12 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 rounded-2xl flex items-center justify-center shadow-lg focus:outline-none transition-all duration-300 transform hover:-translate-y-1">
          <svg class="w-5 h-5 text-white group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
    <!-- Mobile menu with Glassmorphism -->
    <div id="mobile-menu" class="hidden md:hidden">
      <div class="bg-white/80 backdrop-blur-xl rounded-3xl mx-4 mb-4 shadow-xl border border-white/20 overflow-hidden">
        <div class="p-6 space-y-4">
          <%= link_to materials_path, 
              class: "group flex items-center space-x-3 p-4 rounded-2xl font-bold transition-all duration-300 #{'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-lg' if current_page?(materials_path)} #{'bg-amber-50 text-amber-700 hover:bg-amber-100' unless current_page?(materials_path)}" do %>
            <div class="w-10 h-10 <%= current_page?(materials_path) ? 'bg-white/20' : 'bg-amber-200' %> rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8">
                <path fill="currentColor" d="M4 0C0 0 0 8 4 8s4-8 0-8m0 0C2 5 7 3 4 8c2-5-3-3 0-8"/>
              </svg>
            </div>
            <span class="text-lg">Coffee Beans</span>
          <% end %>
          <%= link_to products_path, 
              class: "group flex items-center space-x-3 p-4 rounded-2xl font-bold transition-all duration-300 #{'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-lg' if current_page?(products_path)} #{'bg-amber-50 text-amber-700 hover:bg-amber-100' unless current_page?(products_path)}" do %>
            <div class="w-10 h-10 <%= current_page?(products_path) ? 'bg-white/20' : 'bg-amber-200' %> rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 11h14V8H5zm12.5 0L16 21H8L6.5 11M6 8V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1m-3-3V3"/>
              </svg>
            </div>
            <span class="text-lg">Coffee Menu</span>
          <% end %>
          <%= link_to product_categories_path, 
              class: "group flex items-center space-x-3 p-4 rounded-2xl font-bold transition-all duration-300 #{'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-lg' if current_page?(product_categories_path)} #{'bg-amber-50 text-amber-700 hover:bg-amber-100' unless current_page?(product_categories_path)}" do %>
            <div class="w-10 h-10 <%= current_page?(product_categories_path) ? 'bg-white/20' : 'bg-amber-200' %> rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
              </svg>
            </div>
            <span class="text-lg">Coffee Categories</span>
          <% end %>
          <!-- Mobile Actions -->
          <div class="flex items-center justify-between gap-2 pt-4 border-t border-amber-100">
            <button class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-emerald-50 hover:bg-emerald-100 rounded-xl text-emerald-700 text-sm font-medium transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
              </svg>
              <span>Cart</span>
            </button>
            <button class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-pink-50 hover:bg-pink-100 rounded-xl text-pink-600 text-sm font-medium transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
              <span>Favorites</span>
            </button>
            <% if authenticated? %>
              <%= button_to session_path, method: :delete, class: "flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-xl text-sm font-medium transition" do %>
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
                </svg>
                <span>Logout</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
<!-- Floating Coffee Bean Decorations -->
<div class="fixed top-20 right-8 w-4 h-5 bg-amber-800 rounded-full opacity-20 animate-bounce z-40 hidden lg:block"></div>
<div class="fixed top-32 right-16 w-3 h-4 bg-amber-900 rounded-full opacity-30 animate-bounce delay-300 z-40 hidden lg:block"></div>
<script>
  $(function() {
    var $btn = $('#mobile-menu-button');
    var $menu = $('#mobile-menu');

    $btn.on('click', function() {
      if ($menu.hasClass('hidden')) {
        $menu.removeClass('hidden').css({ display: 'none', opacity: 0 });
        $menu.slideDown(180);
        $menu.animate({ opacity: 1 }, { duration: 180, queue: false });
      } else {
        $menu.animate({ opacity: 0 }, { duration: 140, queue: false });
        $menu.slideUp(180, function() {
          $menu.addClass('hidden');
        });
      }
    });
  });
</script>