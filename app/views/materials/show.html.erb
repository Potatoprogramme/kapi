<div class="min-h-screen bg-amber-50">
  <div class="container mx-auto px-4 py-6 max-w-3xl">
    <!-- Back & Actions -->
    <div class="flex items-center justify-between mb-6">
      <%= link_to materials_path, class: "flex items-center text-sm text-amber-700 hover:text-amber-900 transition-colors" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Beans
      <% end %>
      <div class="flex items-center space-x-2">
        <%= link_to edit_material_path(@material),
            class: 'inline-flex items-center text-sm bg-white border border-amber-300 text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-lg transition-colors' do %>
          <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
        <%= button_to material_path(@material), method: :delete,
            class: 'inline-flex items-center text-sm bg-white border border-red-200 text-red-500 hover:bg-red-50 px-3 py-1.5 rounded-lg transition-colors',
            data: { confirm: 'Are you sure you want to delete this material?' } do %>
          <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      </div>
    </div>
    <!-- Material Header Card -->
    <div class="bg-white border border-amber-200 rounded-xl p-5 mb-4 flex items-center space-x-4">
      <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-amber-700">
          <path d="M16 13V5H6V13C6 14.1046 6.89543 15 8 15H14C15.1046 15 16 14.1046 16 13ZM5 3H20C21.1046 3 22 3.89543 22 5V8C22 9.10457 21.1046 10 20 10H18V13C18 15.2091 16.2091 17 14 17H8C5.79086 17 4 15.2091 4 13V4C4 3.44772 4.44772 3 5 3ZM18 5V8H20V5H18ZM2 19H20V21H2V19Z">
          </path>
        </svg>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-0.5">#<%= @material.id.to_s.rjust(3, '0') %></p>
        <h1 class="text-xl font-semibold text-gray-900"><%= @material.name %></h1>
        <span class="inline-flex items-center text-xs text-amber-700 bg-amber-100 px-2 py-0.5 rounded mt-1">
          <span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-1.5 animate-pulse"></span>
          <%= @material.unit %>
        </span>
      </div>
    </div>
    <!-- Stats Grid -->
    <div class="grid grid-cols-3 gap-3 mb-4">
      <div class="bg-white border border-amber-200 rounded-xl p-4">
        <p class="text-xs text-gray-500 mb-1">Total Cost</p>
        <p class="text-lg font-semibold text-gray-800">₱<%= number_with_delimiter(@material.cost, delimiter: ',') %></p>
      </div>
      <div class="bg-white border border-amber-200 rounded-xl p-4">
        <p class="text-xs text-gray-500 mb-1">Quantity</p>
        <p class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(@material.quantity) %></p>
      </div>
      <div class="bg-white border border-amber-200 rounded-xl p-4">
        <p class="text-xs text-gray-500 mb-1">Unit Price</p>
        <p class="text-lg font-semibold text-gray-800">
          <% if @material.quantity > 0 %>
            ₱<%= number_with_delimiter((@material.cost / @material.quantity).round(2), delimiter: ',') %>
          <% else %>
            N/A
          <% end %>
        </p>
      </div>
    </div>
    <!-- Meta Info -->
    <div class="bg-white border border-amber-200 rounded-xl p-5">
      <h3 class="text-sm font-medium text-gray-700 mb-4">Material Information</h3>
      <div class="grid grid-cols-2 gap-4 text-sm mb-4">
        <div>
          <p class="text-xs text-gray-400 mb-0.5">Created</p>
          <p class="text-gray-700"><%= @material.created_at.strftime("%b %d, %Y · %I:%M %p") %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400 mb-0.5">Last Updated</p>
          <p class="text-gray-700"><%= @material.updated_at.strftime("%b %d, %Y · %I:%M %p") %></p>
        </div>
      </div>
      <!-- Summary Bar -->
      <div class="border-t border-amber-100 pt-4">
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 flex justify-between items-center">
          <div>
            <p class="text-xs text-amber-600 mb-0.5">Total Inventory Value</p>
            <p class="text-xl font-semibold text-amber-900">₱<%= number_with_delimiter(@material.cost, delimiter: ',') %></p>
          </div>
          <div class="text-right">
            <p class="text-xs text-amber-600 mb-0.5">Per Unit</p>
            <p class="text-lg font-medium text-amber-800">
              <% if @material.quantity > 0 %>
                ₱<%= number_with_delimiter((@material.cost / @material.quantity).round(2), delimiter: ',') %>
              <% else %>
                N/A
              <% end %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>