<div class="container mx-auto px-4 py-8">
  <!-- Header Section -->
  <div class="flex items-center justify-between mb-8">
    <%= link_to materials_path, class: "flex items-center text-gray-600 hover:text-blue-600 transition duration-200" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Materials
    <% end %>
    
    <div class="flex space-x-3">
      <%= link_to edit_material_path(@material), 
          class: 'bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center' do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit
      <% end %>
      
      <%= button_to material_path(@material), method: :delete,
          class: 'bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center border-none',
          data: { confirm: 'Are you sure you want to delete this material?' } do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Main Card -->
  <div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-2xl shadow-xl overflow-hidden">
    <div class="p-8">
      <!-- Material Header -->
      <div class="flex items-center mb-8">
        <div class="bg-blue-500 rounded-full p-4 mr-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold text-gray-800 mb-2"><%= @material.name %></h1>
          <div class="flex items-center">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
              <span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span>
              In Stock
            </span>
            <span class="ml-3 text-gray-500">ID: #<%= @material.id %></span>
          </div>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Total Cost -->
        <div class="bg-white rounded-xl p-6 shadow-md border-l-4 border-blue-500">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-blue-100 mr-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-600">Total Cost</p>
              <p class="text-2xl font-bold text-gray-900">₱<%= number_with_delimiter(@material.cost, delimiter: ',') %></p>
            </div>
          </div>
        </div>

        <!-- Quantity -->
        <div class="bg-white rounded-xl p-6 shadow-md border-l-4 border-green-500">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-green-100 mr-4">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-600">Quantity</p>
              <p class="text-2xl font-bold text-gray-900">
                <%= number_with_delimiter(@material.quantity) %>
                <span class="text-sm font-normal text-gray-500"><%= @material.unit %></span>
              </p>
            </div>
          </div>
        </div>

        <!-- Unit Price -->
        <div class="bg-white rounded-xl p-6 shadow-md border-l-4 border-purple-500">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-purple-100 mr-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-600">Unit Price</p>
              <p class="text-2xl font-bold text-gray-900">
                <% if @material.quantity > 0 %>
                  ₱<%= number_with_delimiter((@material.cost / @material.quantity).round(2), delimiter: ',') %>
                <% else %>
                  N/A
                <% end %>
              </p>
            </div>
          </div>
        </div>

        <!-- Unit Type -->
        <div class="bg-white rounded-xl p-6 shadow-md border-l-4 border-amber-500">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-amber-100 mr-4">
              <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.871 4A17.926 17.926 0 003 12c0 2.874.673 5.59 1.871 8m14.13 0a17.926 17.926 0 001.87-8c0-2.874-.673-5.59-1.87-8M9 9h1.246a1 1 0 01.961.725l1.586 5.55a1 1 0 00.961.725H15"></path>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-600">Unit Type</p>
              <p class="text-lg font-bold text-gray-900 capitalize"><%= @material.unit %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Info -->
      <div class="bg-white rounded-xl p-6 shadow-md">
        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
          <svg class="w-5 h-5 mr-2 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Material Information
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <p class="text-sm font-medium text-gray-600 mb-1">Created</p>
            <p class="text-gray-900"><%= @material.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-600 mb-1">Last Updated</p>
            <p class="text-gray-900"><%= @material.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>
        </div>

        <!-- Value Summary -->
        <div class="mt-6 pt-6 border-t border-gray-200">
          <div class="bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg p-4 text-white">
            <div class="flex justify-between items-center">
              <div>
                <p class="text-blue-100 text-sm">Total Inventory Value</p>
                <p class="text-2xl font-bold">₱<%= number_with_delimiter(@material.cost, delimiter: ',') %></p>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm">Per Unit</p>
                <p class="text-xl font-semibold">
                  <% if @material.quantity > 0 %>
                    ₱<%= number_with_delimiter((@material.cost / @material.quantity).round(2), delimiter: ',') %>
                  <% else %>
                    N/A
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>