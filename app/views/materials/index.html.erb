<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50">
  <div class="container mx-auto px-4 py-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 space-y-3 sm:space-y-0">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-gradient-to-r from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-md">
          <span class="text-2xl">🫘</span>
        </div>
        <div>
          <h2 class="text-3xl font-bold bg-gradient-to-r from-amber-700 to-orange-700 bg-clip-text text-transparent mb-1">Coffee Bean Inventory</h2>
          <p class="text-gray-600 text-sm">Manage your premium coffee beans ✨</p>
        </div>
      </div>
      <% if @materials.present? %>
        <%= link_to new_material_path,
            class: 'inline-flex items-center bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 hover:from-amber-600 hover:via-orange-600 hover:to-red-600 text-white font-semibold py-2 px-4 rounded-xl transition-all duration-200 shadow-sm' do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span class="text-sm">Add New Beans</span>
        <% end %>
      <% end %>
    </div>
    <% if @materials.any? %>
      <!-- Coffee Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="relative overflow-hidden rounded-2xl border border-amber-300/40 bg-amber-100/30 backdrop-blur-md shadow-sm p-5">
          <div class="absolute inset-0 bg-gradient-to-br from-amber-200/20 to-orange-300/10 pointer-events-none"></div>
          <div class="relative flex items-center justify-between">
            <div class="w-10 h-10 bg-amber-500/20 border border-amber-400/30 rounded-lg flex items-center justify-center">
              <span class="text-lg">🫘</span>
            </div>
            <div class="text-right">
              <p class="text-xs font-medium text-amber-800/70 mb-0.5">Total Bean Types</p>
              <p class="text-2xl font-semibold text-amber-900"><%= @materials_total_count %></p>
            </div>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-green-300/40 bg-green-100/30 backdrop-blur-md shadow-sm p-5">
          <div class="absolute inset-0 bg-gradient-to-br from-green-200/20 to-emerald-300/10 pointer-events-none"></div>
          <div class="relative flex items-center justify-between">
            <div class="w-10 h-10 bg-green-500/20 border border-green-400/30 rounded-lg flex items-center justify-center">
              <span class="text-lg">💰</span>
            </div>
            <div class="text-right">
              <p class="text-xs font-medium text-green-800/70 mb-0.5">Total Investment</p>
              <p class="text-2xl font-semibold text-green-900">₱<%= number_with_delimiter(@materials_total_cost, delimiter: ',') %></p>
            </div>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-yellow-300/40 bg-yellow-100/30 backdrop-blur-md shadow-sm p-5">
          <div class="absolute inset-0 bg-gradient-to-br from-yellow-200/20 to-amber-300/10 pointer-events-none"></div>
          <div class="relative flex items-center justify-between">
            <div class="w-10 h-10 bg-yellow-500/20 border border-yellow-400/30 rounded-lg flex items-center justify-center">
              <span class="text-lg">⚖️</span>
            </div>
            <div class="text-right">
              <p class="text-xs font-medium text-yellow-800/70 mb-0.5">Unit Types</p>
              <p class="text-2xl font-semibold text-yellow-900"><%= @materials_unit_types %></p>
            </div>
          </div>
        </div>
      </div>
      <!-- Coffee Bean Materials Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @materials.each_with_index do |material, index| %>
          <div class="bg-white/90 rounded-2xl shadow-md border border-white/10 overflow-hidden transition-transform duration-200 hover:-translate-y-1">
            <!-- Card Header -->
            <div class="relative bg-gradient-to-br <%= cycle('from-amber-100 via-orange-200 to-yellow-200', 'from-orange-100 via-red-200 to-pink-200', 'from-yellow-100 via-amber-200 to-orange-200') %> h-32 flex items-center justify-center">
              <div class="absolute top-4 right-4 z-10">
                <div class="bg-white/90 text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                  #<%= material.id.to_s.rjust(3, '0') %>
                </div>
              </div>
              <div class="w-16 h-16 <%= cycle('bg-gradient-to-br from-amber-500 to-orange-600', 'bg-gradient-to-br from-orange-500 to-red-600', 'bg-gradient-to-br from-yellow-500 to-amber-600') %> rounded-xl flex items-center justify-center shadow-md">
                <span class="text-2xl">
                  <%= cycle('🫘', '☕', '🌰') %>
                </span>
              </div>
            </div>
            <!-- Content -->
            <div class="p-6">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-xl font-bold text-gray-800 line-clamp-2 flex-1"><%= material.name %></h3>
                <!-- Dropdown Menu -->
                <div class="relative inline-block text-left ml-2" data-controller="dropdown">
                  <button type="button" 
                          data-action="click->dropdown#toggle click@window->dropdown#hide"
                    class="inline-flex items-center justify-center w-8 h-8 text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/>
                    </svg>
                  </button>
                  <div data-dropdown-target="menu" 
                       class="hidden absolute right-0 mt-2 w-48 rounded-lg shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
                    <div class="py-1">
                      <%= link_to material_path(material), 
                          class: 'flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' do %>
                        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        View Details
                      <% end %>
                      <%= link_to edit_material_path(material), 
                          class: 'flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' do %>
                        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        Edit
                      <% end %>
                      <%= button_to material_path(material), 
                          method: :delete,
                          data: { confirm: 'Are you sure you want to delete this material?' },
                          class: 'flex items-center w-full text-left px-4 py-2 text-sm text-red-700 hover:bg-red-50' do %>
                        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Delete
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-800 border border-amber-200">
                  <span class="w-2 h-2 bg-amber-500 rounded-full mr-2 animate-pulse"></span>
                  <%= material.unit %>
                </span>
              </div>
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div class="text-center p-3 bg-blue-50 rounded-xl border border-blue-100">
                  <p class="text-xs font-medium text-blue-600 mb-1">Quantity</p>
                  <p class="text-lg font-bold text-blue-700"><%= number_with_delimiter(material.quantity) %></p>
                </div>
                <div class="text-center p-3 bg-green-50 rounded-xl border border-green-100">
                  <p class="text-xs font-medium text-green-600 mb-1">Total Cost</p>
                  <p class="text-lg font-bold text-green-700">₱<%= number_with_delimiter(material.cost, delimiter: ',') %></p>
                </div>
              </div>
              <div class="p-3 bg-orange-50 rounded-xl border border-orange-100">
                <div class="flex justify-between items-center text-sm">
                  <span class="text-orange-700">Unit Price</span>
                  <span class="text-orange-800 font-bold">
                    <% if material.quantity > 0 %>
                      ₱<%= number_with_delimiter((material.cost / material.quantity).round(2), delimiter: ',') %>
                    <% else %>
                      N/A
                    <% end %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <%= materials_pagination_nav(@materials_page) %>
    <% else %>
      <!-- Compact Empty State -->
      <div class="text-center py-16">
        <div class="max-w-lg mx-auto">
          <div class="mb-8">
            <div class="bg-gradient-to-br from-amber-200 via-orange-200 to-yellow-200 rounded-full p-8 inline-block shadow-md">
              <div class="bg-white rounded-full p-4">
                <span class="text-6xl">🫘</span>
              </div>
            </div>
          </div>
          <h3 class="text-3xl font-bold mb-3">No coffee beans yet!</h3>
          <p class="text-lg text-gray-600 mb-6">Time to stock up on premium beans ☕</p>
          <%= link_to new_material_path,
              class: 'inline-flex items-center space-x-3 bg-gradient-to-r from-amber-500 to-red-500 text-white font-semibold py-2 px-4 rounded-xl shadow-sm' do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <span class="text-sm">Add Your First Beans</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<script>
  // Stimulus controller for dropdown
  function initDropdowns() {
    $('[data-controller="dropdown"]').each(function() {
      const $dropdown = $(this);
      const $button = $dropdown.find('[data-action*="dropdown#toggle"]');
      const $menu = $dropdown.find('[data-dropdown-target="menu"]');

      // Remove stale listeners before re-attaching
      $button.off('click.dropdown').on('click.dropdown', function(e) {
        e.stopPropagation();
        // Close all other open menus
        $('[data-dropdown-target="menu"]').not($menu).addClass('hidden');
        // Toggle this one
        $menu.toggleClass('hidden');
      });
    });

    // Close all menus on outside click (attached once via namespace)
    $(document).off('click.dropdownOutside').on('click.dropdownOutside', function() {
      $('[data-dropdown-target="menu"]').addClass('hidden');
    });
  }

  // Re-init on every Turbo navigation
  $(document).on('turbo:load turbo:render', function() {
    initDropdowns();
  });

  // Init on plain page load
  $(document).ready(function() {
    initDropdowns();
  });
</script>