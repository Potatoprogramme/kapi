<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Add New Material</h1>
      <p class="text-gray-600">Fill in the details below to add a new material to your inventory</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-lg shadow-lg p-8">
      <%= form_with model: @material, local: true, class: "space-y-6" do |form| %>
        
        <!-- Error Messages -->
        <% if @material.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@material.errors.count, "error") %> prohibited this material from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc list-inside space-y-1">
                    <% @material.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- SECTION 1: Basic Information -->
        <div class="border-b border-gray-200 pb-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Material Name -->
            <div>
              <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :name, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150",
                  placeholder: "Enter material name" %>
            </div>

            <!-- Unit of Measurement -->
            <div>
              <%= form.label :unit, "Unit", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :unit, options_for_select([
                ["grams", "grams"], 
                ["milliliters", "ml"], 
                ["pieces", "pieces"],
              ]),
              {
                  prompt: "Select unit"
              },
                 class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150" %>
            </div>
          </div>
        </div>

        <!-- SECTION 2: Quantity & Pricing -->
        <div class="pb-4">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Quantity & Pricing</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Quantity -->
            <div>
              <%= form.label :quantity, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.number_field :quantity, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150",
                  placeholder: "0",
                  min: 0,
                  step: 0.01 %>
            </div>

            <!-- Total Cost -->
            <div>
              <%= form.label :cost, "Total Cost", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-gray-500 text-sm">₱</span>
                </div>
                <%= form.number_field :cost, 
                    class: "w-full pl-7 pr-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150",
                    placeholder: "0.00",
                    min: 0,
                    step: 0.01 %>
              </div>
            </div>

            <!-- Cost Per Unit (Auto-calculated) -->
            <div>
              <%= form.label :cost_per_unit, "Price/Unit", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-gray-400 text-sm">₱</span>
                </div>
                <%= form.number_field :cost_per_unit, 
                    readonly: true,
                    class: "w-full pl-7 pr-3 py-2 border border-gray-200 bg-gray-50 rounded-md text-gray-600 cursor-not-allowed",
                    placeholder: "0.00",
                    step: 0.01 %>
              </div>
              <p class="text-xs text-gray-500 mt-1">Auto-calculated</p>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="flex justify-between items-center pt-6 border-t border-gray-200">
          <%= link_to 'Cancel', materials_path, 
              class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition duration-150" %>
          <%= form.submit "Save", class: "px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-150 font-medium", data: {disable_with: "Saving..."} %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
    $(document).ready(function() {
    const $costInput = $('#material_cost');
    const $quantityInput = $('#material_quantity');
    const $costPerUnitInput = $('#material_cost_per_unit');

    function calculateUnitPrice() {
        const cost = parseFloat($costInput.val()) || 0;
        const quantity = parseFloat($quantityInput.val()) || 0;

        if (cost > 0 && quantity > 0) {
            const unitPrice = cost / quantity;
            $costPerUnitInput.val(unitPrice.toFixed(3));
        } else {
            $costPerUnitInput.val('');
        }
    }

    // Bind input events
    $costInput.on('input', calculateUnitPrice);
    $quantityInput.on('input', calculateUnitPrice);
  });
</script>