<div class="min-h-screen bg-amber-50 py-8 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-4xl">☕</span>
        <h1 class="text-3xl font-bold text-amber-900">Add New Material</h1>
      </div>
      <p class="text-amber-700 ml-14">Fill in the details below to add a new material to your inventory</p>
    </div>
    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-amber-100 p-8">
      <%= form_with model: @material, class: "space-y-6" do |form| %>
        <!-- Error Messages -->
        <% if @material.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@material.errors.count, "error") %> prohibited this material from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc list-inside space-y-1">
                    <% @material.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <!-- SECTION 1: Basic Information -->
        <div class="border-b border-amber-100 pb-6">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-5 h-5 text-amber-700 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" role="img">
              <path d="M3 6H21V18H3V6ZM2 4C1.44772 4 1 4.44772 1 5V19C1 19.5523 1.44772 20 2 20H22C22.5523 20 23 19.5523 23 19V5C23 4.44772 22.5523 4 22 4H2ZM13 9H19V11H13V9ZM18 13H13V15H18V13ZM6 13H7V16H9V11H6V13ZM9 8H7V10H9V8Z" />
            </svg>
            <h3 class="text-lg font-semibold text-amber-900">Basic Information</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Material Name -->
            <div>
              <%= form.label :name, "Material Name", class: "block text-sm font-medium text-amber-800 mb-2" %>
              <%= form.text_field :name,
                  class: "w-full px-3 py-2 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition duration-150 bg-amber-50 placeholder-amber-300",
                  placeholder: "e.g. Arabica Coffee Beans" %>
            </div>
            <!-- Unit of Measurement -->
            <div>
              <%= form.label :unit, "Unit of Measurement", class: "block text-sm font-medium text-amber-800 mb-2" %>
              <%= form.select :unit, options_for_select([
                ["Grams (g)", "grams"],
                ["Milliliters (ml)", "ml"],
                ["Pieces", "pieces"]
              ]),
              { prompt: "Select unit" },
              class: "w-full px-3 py-2 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition duration-150 bg-amber-50" %>
            </div>
          </div>
        </div>
        <!-- SECTION 2: Quantity & Pricing -->
        <div class="pb-4">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-xl">🏷️</span>
            <h3 class="text-lg font-semibold text-amber-900">Quantity & Pricing</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Quantity -->
            <div>
              <%= form.label :quantity, "Quantity", class: "block text-sm font-medium text-amber-800 mb-2" %>
              <%= form.number_field :quantity,
                  class: "w-full px-3 py-2 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition duration-150 bg-amber-50 placeholder-amber-300",
                  placeholder: "0",
                  min: 0,
                  step: 0.01 %>
            </div>
            <!-- Total Cost -->
            <div>
              <%= form.label :cost, "Total Cost", class: "block text-sm font-medium text-amber-800 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-amber-500 text-sm font-medium">₱</span>
                </div>
                <%= form.number_field :cost,
                    class: "w-full pl-7 pr-3 py-2 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition duration-150 bg-amber-50 placeholder-amber-300",
                    placeholder: "0.00",
                    min: 0,
                    step: 0.01 %>
              </div>
            </div>
            <!-- Cost Per Unit (Auto-calculated) -->
            <div>
              <%= form.label :cost_per_unit, "Cost / Unit", class: "block text-sm font-medium text-amber-800 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-amber-400 text-sm font-medium">₱</span>
                </div>
                <%= form.number_field :cost_per_unit,
                    readonly: true,
                    class: "w-full pl-7 pr-3 py-2 border border-amber-100 bg-amber-50 rounded-lg text-amber-600 cursor-not-allowed",
                    placeholder: "0.00",
                    step: 0.01 %>
              </div>
              <p class="text-xs text-amber-400 mt-1 flex items-center gap-1">
                ✨ Auto-calculated from cost ÷ quantity
              </p>
            </div>
          </div>
        </div>
        <!-- Form Actions -->
        <div class="flex justify-between items-center pt-6 border-t border-amber-100">
          <%= link_to 'Cancel', materials_path,
              class: "px-4 py-2 border border-amber-200 text-amber-700 rounded-lg hover:bg-amber-50 transition duration-150" %>
          <%= form.submit "Save Material",
              class: "px-6 py-2 bg-amber-700 text-white rounded-lg hover:bg-amber-800 focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 transition duration-150 font-medium cursor-pointer",
              data: { disable_with: "Saving..." } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<script>
  $(document).ready(function () {
    const $costInput = $('#material_cost');
    const $quantityInput = $('#material_quantity');
    const $costPerUnitInput = $('#material_cost_per_unit');

    function calculateUnitPrice() {
      const cost = parseFloat($costInput.val()) || 0;
      const quantity = parseFloat($quantityInput.val()) || 0;

      if (cost > 0 && quantity > 0) {
        const unitPrice = cost / quantity;
        $costPerUnitInput.val(unitPrice.toFixed(3));
      } else {
        $costPerUnitInput.val('');
      }
    }

    $costInput.on('input', calculateUnitPrice);
    $quantityInput.on('input', calculateUnitPrice);
  });
</script>