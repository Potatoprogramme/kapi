<!-- filepath: app/views/products/index.html.erb -->
<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50">
  <div class="container mx-auto px-4 py-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 space-y-3 sm:space-y-0">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-gradient-to-r from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-md">
          <span class="text-2xl">☕️</span>
        </div>
        <div>
          <h2 class="text-3xl font-bold bg-gradient-to-r from-amber-700 to-orange-700 bg-clip-text text-transparent mb-1">Coffee Collection</h2>
          <p class="text-gray-600 text-sm">Discover our premium coffee selection ✨</p>
        </div>
      </div>
      <% if @products.present? %>
        <%= link_to new_product_path,
            class: 'inline-flex items-center bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 hover:from-amber-600 hover:via-orange-600 hover:to-red-600 text-white font-semibold py-2 px-4 rounded-xl transition-all duration-200 shadow-sm' do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <span class="text-sm">Add New Coffee</span>
        <% end %>
      <% end %>
    </div>
    <% if @products.any? %>
      <!-- Coffee Products Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        <% @products.each_with_index do |product, index| %>
          <% coffee_origins = ['Ethiopian', 'Colombian', 'Brazilian', 'Guatemalan', 'Costa Rican', 'Jamaican', 'Hawaiian', 'Kenyan'] %>
          <% roast_levels = ['Light Roast', 'Medium Roast', 'Dark Roast', 'French Roast'] %>
          <% coffee_types = ['Arabica', 'Robusta', 'Blend', 'Single Origin'] %>
          
          <div class="group bg-white/80 backdrop-blur-xl rounded-2xl shadow-md hover:shadow-xl border border-white/20 overflow-hidden transition-all duration-500 transform hover:-translate-y-1 hover:rotate-1">
            
            <!-- Coffee Bag/Cup Image with Steam Animation -->
            <div class="relative bg-gradient-to-br <%= cycle('from-amber-100 via-orange-200 to-yellow-200', 'from-orange-100 via-red-200 to-pink-200', 'from-yellow-100 via-amber-200 to-orange-200', 'from-red-100 via-orange-200 to-amber-200', 'from-brown-100 via-amber-200 to-yellow-200') %> h-40 overflow-hidden">

              <% if product.thumbnail.attached? %>
                <%= image_tag product.thumbnail, class: 'absolute inset-0 w-full h-full object-cover' %>
                <div class="absolute inset-0 bg-black/10"></div>
              <% else %>
                <!-- Steam Animation -->
                <div class="absolute top-4 left-1/2 transform -translate-x-1/2">
                  <div class="flex space-x-1">
                    <div class="w-1 h-5 bg-white/40 rounded-full animate-pulse"></div>
                    <div class="w-1 h-4 bg-white/30 rounded-full animate-pulse delay-100"></div>
                    <div class="w-1 h-6 bg-white/40 rounded-full animate-pulse delay-200"></div>
                  </div>
                </div>
                <!-- Coffee Bean Decorations -->
                <div class="absolute top-3 left-3 w-2 h-3 bg-amber-800 rounded-full transform rotate-12 animate-bounce"></div>
                <div class="absolute top-5 right-5 w-1.5 h-2 bg-amber-700 rounded-full animate-pulse"></div>
                <div class="absolute bottom-4 left-5 w-1.5 h-2 bg-amber-900 rounded-full animate-bounce delay-300"></div>
                <div class="flex items-center justify-center h-full">
                  <div class="w-14 h-14 <%= cycle('bg-gradient-to-br from-amber-500 to-orange-600', 'bg-gradient-to-br from-orange-500 to-red-600', 'bg-gradient-to-br from-yellow-500 to-amber-600', 'bg-gradient-to-br from-red-500 to-orange-600', 'bg-gradient-to-br from-amber-600 to-yellow-600') %> rounded-2xl flex items-center justify-center shadow-lg transform group-hover:rotate-12 group-hover:scale-110 transition-all duration-500">
                    <span class="text-2xl">☕</span>
                  </div>
                </div>
              <% end %>

              <!-- Product ID Badge -->
              <div class="absolute top-3 right-3 z-10">
                <div class="bg-white/90 backdrop-blur-sm <%= cycle('text-amber-600', 'text-orange-600', 'text-yellow-600', 'text-red-600') %> text-xs font-black px-2.5 py-1 rounded-full shadow-md">
                  #<%= product.id.to_s.rjust(3, '0') %>
                </div>
              </div>

              <!-- Roast Level Indicator -->
              <div class="absolute bottom-2 left-3 z-10">
                <div class="bg-amber-800/80 text-white text-xs font-bold px-2 py-0.5 rounded-full backdrop-blur-sm">
                  <%= roast_levels.sample %>
                </div>
              </div>
            </div>

            <!-- Coffee Product Content -->
            <div class="p-4">
              <!-- Coffee Name -->
              <h3 class="text-base font-black text-gray-800 mb-1 line-clamp-1 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-amber-700 group-hover:to-orange-700 group-hover:bg-clip-text transition-all duration-300">
                <%= link_to product.name, product_path(product) %>
              </h3>
              
              <!-- Origin & Type -->
              <p class="text-xs text-gray-500 font-medium mb-3 flex items-center space-x-1">
                <span class="text-amber-600">🌍</span>
                <span><%= coffee_origins.sample %> · <%= coffee_types.sample %></span>
              </p>
              
              <!-- Coffee Price Display -->
              <div class="mb-3 px-3 py-2 bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl border border-green-100">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-lg font-black text-green-600">₱<%= number_with_delimiter(rand(299..1299), delimiter: ',') %></span>
                    <span class="text-xs text-green-400 line-through ml-1">₱<%= number_with_delimiter(rand(1300..2000), delimiter: ',') %></span>
                  </div>
                  <div class="bg-red-400 text-white text-xs font-black px-2 py-0.5 rounded-full rotate-12 shadow-sm">
                    FRESH! ☕
                  </div>
                </div>
              </div>

              <!-- Coffee Rating & Tasting Notes -->
              <div class="mb-3 px-3 py-2 bg-amber-50 rounded-xl border border-amber-100">
                <div class="flex items-center justify-between mb-1">
                  <div class="flex space-x-0.5">
                    <% 5.times do |i| %>
                      <div class="w-3 h-3 text-amber-400">
                        <svg class="w-full h-full fill-current" viewBox="0 0 20 20">
                          <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                        </svg>
                      </div>
                    <% end %>
                  </div>
                  <span class="text-xs font-bold text-gray-500">(4.<%= rand(7..9) %>)</span>
                </div>
                <p class="text-xs text-amber-700 font-medium truncate">
                  <%= ['Notes of chocolate & vanilla', 'Nutty with caramel finish', 'Fruity & floral aroma', 'Rich & bold flavor', 'Smooth & creamy'].sample %>
                </p>
              </div>

              <!-- Brewing Methods -->
              <div class="mb-3 flex flex-wrap gap-1">
                <% ['Espresso', 'Pour Over', 'French Press', 'Cold Brew'].sample(2).each do |method| %>
                  <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full font-medium">
                    <%= method %>
                  </span>
                <% end %>
              </div>

              <!-- Action Buttons -->
              <div class="space-y-2">
                <!-- View & Edit Row -->
                <div class="flex space-x-2">
                  <%= link_to edit_product_path(product), 
                      class: 'flex-1 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold py-2 px-3 rounded-lg transition-all duration-300 text-center text-xs group shadow hover:shadow-md' do %>
                    <div class="flex items-center justify-center space-x-1">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      <span>Edit</span>
                    </div>
                  <% end %>
                </div>

                <!-- Add to Cart Style Button -->
                <button class="w-full bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-bold py-2 px-4 rounded-lg transition-all duration-300 text-xs group shadow hover:shadow-md">
                  <div class="flex items-center justify-center space-x-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m1.6 8L5 3H3m4 10v6a1 1 0 001 1h10a1 1 0 001-1v-6M9 19h6"></path>
                    </svg>
                    <span>Add to Cart</span>
                  </div>
                </button>

                <!-- Delete Button -->
                <%= button_to product_path(product), method: :delete,
                    class: 'w-full bg-gradient-to-r from-red-400 to-pink-500 hover:from-red-500 hover:to-pink-600 text-white font-bold py-2 px-4 rounded-lg transition-all duration-300 border-none text-xs group shadow hover:shadow-md',
                    data: { confirm: '☕ Are you sure you want to remove this delicious coffee from your collection?' } do %>
                  <div class="flex items-center justify-center space-x-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    <span>Remove Coffee</span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Coffee Empty State -->
      <div class="text-center py-24">
        <div class="max-w-lg mx-auto">
          <!-- Floating Coffee Animation -->
          <div class="relative mb-12">
            <div class="bg-gradient-to-br from-amber-200 via-orange-200 to-yellow-200 rounded-full p-16 inline-block shadow-2xl animate-pulse">
              <div class="bg-white rounded-full p-8 shadow-inner">
                <span class="text-8xl">☕</span>
              </div>
            </div>
            <!-- Steam Animation -->
            <div class="absolute -top-8 left-1/2 transform -translate-x-1/2">
              <div class="flex space-x-2">
                <div class="w-2 h-12 bg-amber-400/60 rounded-full animate-pulse"></div>
                <div class="w-2 h-10 bg-orange-400/60 rounded-full animate-pulse delay-100"></div>
                <div class="w-2 h-14 bg-yellow-400/60 rounded-full animate-pulse delay-200"></div>
              </div>
            </div>
            <!-- Coffee Beans -->
            <div class="absolute -top-4 -right-4 w-6 h-8 bg-amber-800 rounded-full animate-bounce"></div>
            <div class="absolute -bottom-2 -left-6 w-4 h-6 bg-amber-900 rounded-full animate-bounce delay-300"></div>
          </div>
          
          <h3 class="text-5xl font-black bg-gradient-to-r from-amber-700 to-orange-700 bg-clip-text text-transparent mb-6">
            No coffee yet! 
          </h3>
          <p class="text-2xl text-gray-600 mb-4 font-medium">Time to brew something amazing! ☕</p>
          <p class="text-lg text-gray-500 mb-12">Your customers are craving the perfect cup 🤤</p>
          
          <%= link_to new_product_path, 
              class: 'inline-flex items-center space-x-4 bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 hover:from-amber-600 hover:via-orange-600 hover:to-red-600 text-white font-black py-6 px-12 rounded-3xl transition-all duration-300 shadow-2xl hover:shadow-3xl transform hover:-translate-y-2 text-xl group' do %>
            <div class="w-8 h-8 bg-white/20 rounded-xl flex items-center justify-center group-hover:rotate-180 transition-transform duration-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
            </div>
            <span>Add Your First Blend</span>
            <span class="text-2xl">☕</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>