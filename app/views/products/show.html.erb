<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50">
  <div class="max-w-2xl mx-auto px-4 py-10">
    <!-- Product Header -->
    <% product = @product.is_a?(ActiveRecord::Relation) ? @product.first : @product %>
    <div class="bg-white/80 rounded-3xl border border-amber-100 shadow-xl mb-4 p-6">
      <h1 class="text-2xl font-black text-amber-900"><%= product.name %></h1>
      <p class="text-xs text-amber-400 mt-1">Created by: <%= product.email_address %></p>
      <p class="text-xs text-amber-400 mt-1">ID #<%= product.id %> · Added <%= product.created_at.strftime("%b %d, %Y") %></p>
      <p class="text-xs text-amber-900 font-semibold mb-0.5">Category: <%= product&.category_name %></p>
      <p class="text-xs text-amber-500 font-semibold mb-0.5">Category Description: <%= product&.description %></p>
      <p class="text-xs font-bold <%= product.status == "active" ? "text-green-700" : "text-gray-500" %>">Status: <%= product.status.capitalize %></p>
      <div class="text-right shrink-0 mt-2">
        <p class="text-xs text-amber-500 font-semibold mb-0.5">Selling Price</p>
        <p class="text-3xl font-black text-orange-600">₱<%= number_with_precision(product.selling_price, precision: 2) %></p>
      </div>
    </div>
    <!-- Ingredients Section -->
    <div class="bg-white/80 rounded-3xl border border-amber-100 shadow-xl mb-4">
      <div class="px-6 pt-6 pb-4 border-b border-amber-50 flex items-center gap-2">
        <h2 class="text-sm font-bold text-amber-900">Ingredients</h2>
        <span class="ml-auto text-xs font-semibold text-amber-500 bg-amber-100 px-2.5 py-0.5 rounded-full">
          <%= @ingredients.count %> <%= "item".pluralize(@ingredients.count) %>
        </span>
      </div>
      <div class="divide-y divide-amber-50">
        <% @ingredients.each do |ing| %>
          <div class="flex items-center gap-4 px-6 py-3.5">
            <div class="flex-1">
              <p class="text-sm font-bold text-amber-900"><%= ing.material&.name %></p>
              <p class="text-xs text-amber-400 mt-0.5">
                ₱<%= number_with_precision(ing.material&.cost_per_unit, precision: 2) %> / <%= ing.material&.unit %>
              </p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-amber-700">
                <%= number_with_precision(ing.quantity, precision: 2) %> <%= ing.material&.unit %>
              </p>
              <p class="text-xs font-bold text-orange-600 mt-0.5">
                ₱<%= number_with_precision(ing&.ingredient_total_cost, precision: 2) %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
      <div class="flex items-center justify-between px-6 py-3.5 bg-amber-50/60 border-t border-amber-100">
        <p class="text-xs font-bold text-amber-700 uppercase tracking-wide">Direct Cost</p>
        <p class="text-base font-black text-amber-900">₱<%= number_with_precision(product.direct_cost, precision: 2) %></p>
      </div>
    </div>
    <!-- Costing Breakdown Section -->
    <div class="bg-white/80 rounded-3xl border border-amber-100 shadow-xl mb-6">
      <div class="px-6 pt-6 pb-4 border-b border-amber-50 flex items-center gap-2">
        <h2 class="text-sm font-bold text-amber-900">Costing Breakdown</h2>
      </div>
      <div class="divide-y divide-amber-50">
        <div class="flex items-center justify-between px-6 py-4">
          <div>
            <p class="text-sm font-bold text-amber-900">Direct Cost</p>
            <p class="text-xs text-amber-400">Sum of all ingredients</p>
          </div>
          <p class="text-sm font-black text-amber-800">₱<%= number_with_precision(product.direct_cost, precision: 2) %></p>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <div>
            <p class="text-sm font-bold text-amber-900">Overhead</p>
            <p class="text-xs text-amber-400">
              <%= number_with_precision(product.overhead_percentage, precision: 1) %>% of direct cost
            </p>
          </div>
          <div class="text-right">
            <p class="text-sm font-black text-amber-800">₱<%= number_with_precision(product.overhead_cost, precision: 2) %></p>
            <span class="text-xs font-bold text-amber-500 bg-amber-100 px-2 py-0.5 rounded-lg">
              <%= number_with_precision(product.overhead_percentage, precision: 1) %>%
            </span>
          </div>
        </div>
        <div class="flex items-center justify-between px-6 py-4 bg-amber-50/60">
          <div>
            <p class="text-sm font-bold text-amber-900">Total Cost</p>
            <p class="text-xs text-amber-400">Direct Cost + Overhead</p>
          </div>
          <p class="text-base font-black text-orange-700">₱<%= number_with_precision(product.total_cost, precision: 2) %></p>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <div>
            <p class="text-sm font-bold text-amber-900">Profit Margin</p>
            <p class="text-xs text-amber-400">
              <%= number_with_precision(product.profit_margin_percentage, precision: 1) %>% of selling price
            </p>
          </div>
          <div class="text-right">
            <p class="text-sm font-black text-amber-800">₱<%= number_with_precision(product.profit_margin_amount, precision: 2) %></p>
            <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-lg">
              <%= number_with_precision(product.profit_margin_percentage, precision: 1) %>%
            </span>
          </div>
        </div>
        <div class="flex items-center justify-between px-6 py-5 bg-gradient-to-r from-amber-400/20 to-orange-400/20">
          <div>
            <p class="text-sm font-black text-amber-900">Final Selling Price</p>
            <p class="text-xs text-amber-500 mt-0.5">
              <% profit = product.selling_price.to_f - product.total_cost.to_f %>
              <% margin = product.selling_price.to_f > 0 ? (profit / product.selling_price.to_f * 100) : 0 %>
              <span class="<%= profit >= 0 ? 'text-green-600' : 'text-red-500' %> font-bold">
                ₱<%= number_with_precision(profit, precision: 2) %> profit
              </span>
              · <%= number_with_precision(margin, precision: 1) %>% actual margin
            </p>
          </div>
          <p class="text-2xl font-black text-orange-600">₱<%= number_with_precision(product.selling_price, precision: 2) %></p>
        </div>
      </div>
    </div>
  </div>
</div>