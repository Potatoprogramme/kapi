<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50">
  <div class="container mx-auto px-4 py-8">
    <!-- Back Button -->
    <div class="mb-6">
      <%= link_to products_path, 
          class: 'inline-flex items-center space-x-2 text-amber-700 hover:text-amber-800 font-medium transition-colors duration-200' do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Back to Coffee Collection</span>
      <% end %>
    </div>

    <!-- Form Header -->
    <div class="text-center mb-12">
      <div class="relative mb-8">
        <div class="bg-gradient-to-br from-amber-200 via-orange-200 to-yellow-200 rounded-full p-12 inline-block shadow-2xl">
          <div class="bg-white rounded-full p-6 shadow-inner">
            <span class="text-6xl">☕</span>
          </div>
        </div>
        <!-- Steam Animation -->
        <div class="absolute -top-6 left-1/2 transform -translate-x-1/2">
          <div class="flex space-x-1">
            <div class="w-1.5 h-10 bg-amber-400/60 rounded-full animate-pulse"></div>
            <div class="w-1.5 h-8 bg-orange-400/60 rounded-full animate-pulse delay-100"></div>
            <div class="w-1.5 h-12 bg-yellow-400/60 rounded-full animate-pulse delay-200"></div>
          </div>
        </div>
        <!-- Coffee Beans -->
        <div class="absolute -top-2 -right-2 w-4 h-5 bg-amber-800 rounded-full animate-bounce"></div>
        <div class="absolute -bottom-1 -left-3 w-3 h-4 bg-amber-900 rounded-full animate-bounce delay-300"></div>
      </div>
      
      <h1 class="text-5xl font-black bg-gradient-to-r from-amber-700 to-orange-700 bg-clip-text text-transparent mb-4">
        Add New Coffee Blend
      </h1>
      <p class="text-xl text-gray-600 font-medium">Create your perfect coffee blend ✨</p>
    </div>

    <!-- Coffee Form -->
    <div class="max-w-2xl mx-auto">
      <div class="bg-white/80 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/20 overflow-hidden">
        <div class="p-8">
          <%= form_with(model: @product, local: true, multipart: true) do |form| %>
            <!-- Coffee Name Field -->
            <div class="space-y-4">
              <%= form.label :name, class: "block text-2xl font-black text-gray-800 mb-4" do %>
                <div class="flex items-center space-x-3">
                  <div class="w-8 h-8 bg-gradient-to-r from-amber-500 to-orange-600 rounded-xl flex items-center justify-center">
                    <span class="text-lg">☕</span>
                  </div>
                  <span>Coffee Name</span>
                </div>
              <% end %>
        
              <%= form.text_field :name, 
                  class: "w-full px-6 py-4 text-xl font-medium border-3 border-amber-200 rounded-2xl focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 transition-all duration-300 bg-white/80 backdrop-blur-sm placeholder-gray-400",
                  placeholder: "e.g., Colombian Supreme, Ethiopian Sunrise, Mocha Delight...",
                  required: true %>
              
              <div class="flex items-center space-x-2 text-sm text-gray-600">
                <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Give your coffee a memorable and appetizing name that customers will love!</span>
              </div>
            </div>
             
            <div class="space-y-4">
              <label class="block text-2xl font-black text-gray-800">
                <div class="flex items-center space-x-3 mb-4">
                  <div class="w-8 h-8 bg-gradient-to-r from-amber-500 to-orange-600 rounded-xl flex items-center justify-center">
                    <span class="text-lg">🖼️</span>
                  </div>
                  <span>Thumbnail</span>
                </div>
              </label>

              <label class="group flex flex-col items-center justify-center w-full h-36 border-2 border-dashed border-amber-300 hover:border-amber-500 rounded-2xl cursor-pointer bg-amber-50/50 hover:bg-amber-50 transition-all duration-300">
                <div class="flex flex-col items-center justify-center space-y-2 text-center px-4">
                  <div class="w-10 h-10 bg-gradient-to-r from-amber-400 to-orange-500 rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-bold text-amber-700">Click to upload image</p>
                    <p class="text-xs text-gray-400 mt-0.5">PNG, JPG or GIF</p>
                  </div>
                </div>
                <%= form.file_field :thumbnail, accept: "image/png, image/jpeg, image/gif", class: "hidden" %>
              </label>
            </div>

            <!-- Coffee Inspiration Examples -->
            <div class="mt-4 bg-gradient-to-r from-amber-50 to-orange-50 rounded-2xl p-6 border border-amber-100">
              <h3 class="text-lg font-bold text-amber-800 mb-4 flex items-center space-x-2">
                <span class="text-xl">💡</span>
                <span>Need Inspiration?</span>
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="space-y-2">
                  <p class="font-semibold text-amber-700 text-sm">By Origin:</p>
                  <div class="flex flex-wrap gap-2">
                    <% ['Colombian Gold', 'Ethiopian Bloom', 'Brazilian Santos', 'Guatemalan Antigua'].each do |name| %>
                      <button type="button" onclick="document.getElementById('product_name').value='<%= name %>'" 
                              class="text-xs bg-amber-200 hover:bg-amber-300 text-amber-800 px-3 py-1 rounded-full transition-colors duration-200 cursor-pointer">
                        <%= name %>
                      </button>
                    <% end %>
                  </div>
                </div>
                <div class="space-y-2">
                  <p class="font-semibold text-amber-700 text-sm">By Flavor:</p>
                  <div class="flex flex-wrap gap-2">
                    <% ['Vanilla Dream', 'Caramel Bliss', 'Chocolate Velvet', 'Nutty Delight'].each do |name| %>
                      <button type="button" onclick="document.getElementById('product_name').value='<%= name %>'" 
                              class="text-xs bg-orange-200 hover:bg-orange-300 text-orange-800 px-3 py-1 rounded-full transition-colors duration-200 cursor-pointer">
                        <%= name %>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Error Messages -->
            <% if @product.errors.any? %>
              <div class="bg-red-50 border-2 border-red-200 rounded-2xl p-6">
                <div class="flex items-center space-x-3 mb-4">
                  <div class="w-8 h-8 bg-red-500 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <h4 class="text-xl font-bold text-red-800">Oops! Something went wrong</h4>
                </div>
                <ul class="space-y-2">
                  <% @product.errors.full_messages.each do |message| %>
                    <li class="text-red-700 font-medium flex items-center space-x-2">
                      <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                      <span><%= message %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4 pt-6">
              <%= form.submit "Save Coffee Blend", 
                  class: "flex-1 bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 hover:from-amber-600 hover:via-orange-600 hover:to-red-600 text-white font-black py-4 px-8 rounded-2xl transition-all duration-300 shadow-lg hover:shadow-2xl transform hover:-translate-y-1 text-xl cursor-pointer flex items-center justify-center space-x-3 group" %>
              <%= link_to products_path, 
                  class: "flex-1 bg-gradient-to-r from-gray-200 to-gray-300 hover:from-gray-300 hover:to-gray-400 text-gray-700 font-black py-4 px-8 rounded-2xl transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 text-xl text-center flex items-center justify-center space-x-3 group" do %>
                <svg class="w-6 h-6 group-hover:scale-110 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <span>Cancel</span>
              <% end %>
            </div>

            <div class="text-center pt-4">
              <p class="text-sm text-gray-500 flex items-center justify-center space-x-2">
                <span class="text-lg">🔒</span>
                <span>Your coffee blend will be securely saved</span>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>