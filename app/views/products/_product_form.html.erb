<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50">
  <div class="container mx-auto px-4 py-6">
    <!-- Back Button -->
    <div class="mb-4">
      <%= link_to products_path, 
          class: 'inline-flex items-center space-x-1.5 text-sm text-amber-700 hover:text-amber-800 font-medium transition-colors duration-200' do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Back to Coffee Collection</span>
      <% end %>
    </div>
    <!-- Form Header -->
    <div class="text-center mb-8">
      <div class="relative mb-5">
        <div class="bg-gradient-to-br from-amber-200 via-orange-200 to-yellow-200 rounded-full p-8 inline-block shadow-xl">
          <div class="bg-white rounded-full p-4 shadow-inner">
            <span class="text-4xl">☕</span>
          </div>
        </div>
        <!-- Steam Animation -->
        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
          <div class="flex space-x-1">
            <div class="w-1 h-7 bg-amber-400/60 rounded-full animate-pulse"></div>
            <div class="w-1 h-5 bg-orange-400/60 rounded-full animate-pulse delay-100"></div>
            <div class="w-1 h-8 bg-yellow-400/60 rounded-full animate-pulse delay-200"></div>
          </div>
        </div>
        <!-- Coffee Beans -->
        <div class="absolute -top-1 -right-1 w-3 h-3.5 bg-amber-800 rounded-full animate-bounce"></div>
        <div class="absolute -bottom-0.5 -left-2 w-2.5 h-3 bg-amber-900 rounded-full animate-bounce delay-300"></div>
      </div>
      <h1 class="text-3xl font-black bg-gradient-to-r from-amber-700 to-orange-700 bg-clip-text text-transparent mb-2">
        <%= @product.new_record? ? 'Add New Coffee Blend' : 'Edit Coffee Blend' %>
      </h1>
      <p class="text-sm text-gray-600 font-medium">Create your perfect coffee blend ✨</p>
    </div>
    <!-- Coffee Form -->
    <div class="max-w-xl mx-auto">
      <div class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-xl border border-white/20 overflow-hidden">
        <div class="p-6">
          <%= form_with(model: @product, local: true, multipart: true) do |form| %>
            <!-- Coffee Name Field -->
            <div class="space-y-2 mb-4">
              <%= form.label :name, class: "block text-base font-bold text-gray-800 mb-1" do %>
                <div class="flex items-center space-x-2">
                  <div class="w-6 h-6 bg-gradient-to-r from-amber-500 to-orange-600 rounded-lg flex items-center justify-center">
                    <span class="text-xs">☕</span>
                  </div>
                  <span>Coffee Name</span>
                </div>
              <% end %>
              <%= form.text_field :name, 
                  id: 'product_name',
                  class: "w-full px-4 py-2.5 text-sm font-medium border-2 border-amber-200 rounded-xl focus:border-amber-500 focus:ring-2 focus:ring-amber-200/50 transition-all duration-300 bg-white/80 placeholder-gray-400",
                  placeholder: "e.g., Colombian Supreme, Ethiopian Sunrise...",
                  required: true %>
              <div class="flex items-center space-x-1.5 text-xs text-gray-500">
                <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Give your coffee a memorable name</span>
              </div>
            </div>
            <!-- Product Category Field-->
            <div class="space-y-2 mb-4">
              <%= form.label :category, class: "block text-base font-bold text-gray-800 mb-1" do %>
                <div class="flex items-center space-x-2">
                  <div class="w-6 h-6 bg-gradient-to-r from-amber-500 to-orange-600 rounded-lg flex items-center justify-center">
                    <span class="text-xs">☕</span>
                  </div>
                  <span>Coffee Category</span>
                </div>
              <% end %>
              <select name="product_category">
                <% if @categories.any? %>
                  <% @categories.each do |category|%>
                    <option value="<%= category.id %>"><%= category.name %> </option>
                  <% end %>
                <% else %>
                  <option value="<%= category.id %>"><%= category.name %> </option>
                <% end %>
              </select>
              <div class="flex items-center space-x-1.5 text-xs text-gray-500">
                <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Assign a label to your coffee</span>
              </div>
            </div>
            <div class="space-y-2 mb-4">
              <label class="block text-base font-bold text-gray-800">
                <div class="flex items-center space-x-2 mb-1">
                  <div class="w-6 h-6 bg-gradient-to-r from-amber-500 to-orange-600 rounded-lg flex items-center justify-center">
                    <span class="text-xs">🖼️</span>
                  </div>
                  <span>Thumbnail</span>
                </div>
              </label>
              <label class="group flex flex-col items-center justify-center w-full h-28 border-2 border-dashed border-amber-300 hover:border-amber-500 rounded-xl cursor-pointer bg-amber-50/50 hover:bg-amber-50 transition-all duration-300">
                <div class="flex flex-col items-center justify-center space-y-1.5 text-center px-4">
                  <div class="w-8 h-8 bg-gradient-to-r from-amber-400 to-orange-500 rounded-lg flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-bold text-amber-700">Click to upload image</p>
                    <p class="text-[10px] text-gray-400">PNG, JPG or GIF</p>
                  </div>
                </div>
                <%= form.file_field :thumbnail, accept: "image/png, image/jpeg, image/gif", class: "hidden" %>
              </label>
              <% if @product&.thumbnail&.attached? %>
                <div class="mt-2">
                  <p class="text-xs text-gray-500 mb-1">Current image</p>
                  <div class="w-28 h-28 overflow-hidden rounded-lg border border-gray-200 shadow-sm">
                    <%= image_tag @product.thumbnail,
                                  class: "object-cover w-full h-full" %>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="space-y-2 mb-4">
              <label class="block text-base font-bold text-gray-800">
                <div class="flex items-center space-x-2 mb-1">
                  <div class="w-6 h-6 bg-gradient-to-r from-amber-500 to-orange-600 rounded-lg flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="text-white size-5" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                    </svg>
                  </div>
                  <span>Add Ingredients</span>
                </div>
              </label>
              <% if @materials.any? %>
                <div class="my-4">
                  <select name="materials" id="materials" class="w-120">
                    <% @materials.each do |material| %>
                      <option value="<%= material.id %>"><%= material.name %></option>
                    <% end %>
                  </select>
                  <button type="button" id="addIng" class="bg-blue-200 px-4 py-1 text-blue-800 rounded-md font-bold">Add</button>
                </div>
              <% end %>
              <div id="ingDisplay" class=" bg-orange-50 w-auto">
              </div>
              <script>
                var ingList = []; // array for storing the ingredients (objects with id and name)

                // Adding ingredients to the list
                $('#addIng').on("click", function(){
                  let selectedId = $('#materials').val();
                  let selectedName = $('#materials option:selected').text();

                  // Prevent duplicates
                  if (ingList.some(i => i.id === selectedId)) return;

                  ingList.push({ id: selectedId, name: selectedName });

                  $('#ingDisplay').append(`
                    <div id="ing-${selectedId}" class="flex gap-2 items-center">
                      <span>${selectedName}</span>
                      <button type="button" class="remove-ing text-red-500" data-id="${selectedId}">Remove</button>
                    </div>
                  `)

                  updateHiddenInputs();
                });

                // Removing an ingredient
                $(document).on('click', '.remove-ing', function(){
                  let id = $(this).data("id").toString();

                  // Remove from array
                  ingList = ingList.filter(i => i.id !== id);

                  // Remove from display
                  $(`#ing-${id}`).remove();

                  // Update hidden inputs
                  updateHiddenInputs();
                });

                // Updating Form Input
                function updateHiddenInputs(){
                  // Remove only dynamically added hidden inputs inside ingDisplay
                  $("#ingDisplay input[name='myIngredients[]']").remove();

                  ingList.forEach(function(item){
                    $('<input>').attr({
                      type:  'hidden',
                      name:  'myIngredients[]',
                      value: item.id
                    }).appendTo('#ingDisplay');
                  });
                }
              </script>
            </div>
            <!-- Coffee Inspiration Examples -->
            <div class="mb-4 bg-gradient-to-r from-amber-50 to-orange-50 rounded-xl p-4 border border-amber-100">
              <h3 class="text-sm font-bold text-amber-800 mb-2 flex items-center space-x-1.5">
                <span>💡</span>
                <span>Need Inspiration?</span>
              </h3>
              <div class="grid grid-cols-2 gap-2">
                <div class="space-y-1">
                  <p class="font-semibold text-amber-700 text-xs">By Origin:</p>
                  <div class="flex flex-wrap gap-1.5">
                    <% ['Colombian Gold', 'Ethiopian Bloom', 'Brazilian Santos', 'Guatemalan Antigua'].each do |name| %>
                      <button type="button" onclick="document.getElementById('product_name').value='<%= name %>'" 
                              class="text-[11px] bg-amber-200 hover:bg-amber-300 text-amber-800 px-2 py-0.5 rounded-full transition-colors duration-200 cursor-pointer">
                        <%= name %>
                      </button>
                    <% end %>
                  </div>
                </div>
                <div class="space-y-1">
                  <p class="font-semibold text-amber-700 text-xs">By Flavor:</p>
                  <div class="flex flex-wrap gap-1.5">
                    <% ['Vanilla Dream', 'Caramel Bliss', 'Chocolate Velvet', 'Nutty Delight'].each do |name| %>
                      <button type="button" onclick="document.getElementById('product_name').value='<%= name %>'" 
                              class="text-[11px] bg-orange-200 hover:bg-orange-300 text-orange-800 px-2 py-0.5 rounded-full transition-colors duration-200 cursor-pointer">
                        <%= name %>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            <!-- Error Messages -->
            <% if @product.errors.any? %>
              <div class="mb-4 bg-red-50 border border-red-200 rounded-xl p-4">
                <div class="flex items-center space-x-2 mb-2">
                  <div class="w-5 h-5 bg-red-500 rounded-lg flex items-center justify-center">
                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <h4 class="text-sm font-bold text-red-800">Something went wrong</h4>
                </div>
                <ul class="space-y-1">
                  <% @product.errors.full_messages.each do |message| %>
                    <li class="text-xs text-red-700 flex items-center space-x-1.5">
                      <span class="w-1.5 h-1.5 bg-red-400 rounded-full"></span>
                      <span><%= message %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <!-- Action Buttons -->
            <div class="flex space-x-3 pt-2">
              <%= form.submit "Save Coffee Blend", 
                  class: "flex-1 bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 hover:from-amber-600 hover:via-orange-600 hover:to-red-600 text-white font-bold py-2.5 px-5 rounded-xl transition-all duration-300 shadow-md hover:shadow-lg text-sm cursor-pointer" %>
              <%= link_to products_path, 
                  class: "flex-1 bg-gradient-to-r from-gray-200 to-gray-300 hover:from-gray-300 hover:to-gray-400 text-gray-700 font-bold py-2.5 px-5 rounded-xl transition-all duration-300 shadow-sm text-sm text-center" do %>
                Cancel
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
