<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <%# Header %>
    <div class="text-center mb-10">
      <div class="relative inline-block mb-5">
        <div class="absolute -top-5 left-1/2 -translate-x-1/2 flex gap-1.5">
          <div class="w-1 h-6 bg-amber-300/70 rounded-full" style="animation: steamRise 2s ease-in-out infinite;"></div>
          <div class="w-1 h-8 bg-orange-300/70 rounded-full" style="animation: steamRise 2s ease-in-out infinite; animation-delay: 0.4s;"></div>
          <div class="w-1 h-5 bg-amber-300/70 rounded-full" style="animation: steamRise 2s ease-in-out infinite; animation-delay: 0.8s;"></div>
        </div>
        <div class="w-20 h-20 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-200">
          <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center">
            <span class="text-3xl">☕</span>
          </div>
        </div>
        <div class="absolute -top-1 -right-2 w-3 h-4 bg-amber-800 rounded-full" style="animation: floatBean 3s ease-in-out infinite;"></div>
        <div class="absolute -bottom-1 -left-2 w-2.5 h-3 bg-amber-900 rounded-full" style="animation: floatBean 3s ease-in-out infinite; animation-delay: 1.5s;"></div>
      </div>
      <h1 class="text-3xl font-black text-amber-900 tracking-tight mb-1">Join KAPI</h1>
      <p class="text-sm text-amber-600/80 font-medium">Create your account and start brewing ✨</p>
    </div>
    <%# Card %>
    <div class="bg-white/80 backdrop-blur-sm rounded-3xl border border-amber-100 shadow-xl shadow-amber-100/50 overflow-hidden">
      <%= form_with model: @user, url: registrations_path do |f| %>
        <div class="p-8 space-y-5">
          <%# Email %>
          <div>
            <%= f.label :email_address, class: "block text-sm font-bold text-amber-900 mb-1.5" do %>
              <div class="flex items-center gap-2">
                <div class="w-5 h-5 bg-gradient-to-br from-amber-400 to-orange-500 rounded-md flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                Email address
              </div>
            <% end %>
            <%= f.email_field :email_address,
              required: true,
              autofocus: true,
              placeholder: "you@kapi.com",
              class: "w-full px-4 py-3 text-sm text-amber-900 bg-amber-50/60 border border-amber-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all placeholder-amber-300 font-medium" %>
          </div>
          <%# Password %>
          <div>
            <%= f.label :password, class: "block text-sm font-bold text-amber-900 mb-1.5" do %>
              <div class="flex items-center gap-2">
                <div class="w-5 h-5 bg-gradient-to-br from-amber-400 to-orange-500 rounded-md flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                </div>
                Password
              </div>
            <% end %>
            <div class="relative">
              <%= f.password_field :password,
                required: true,
                placeholder: "At least 6 characters",
                id: "password_field",
                class: "w-full px-4 py-3 pr-12 text-sm text-amber-900 bg-amber-50/60 border border-amber-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all placeholder-amber-300 font-medium" %>
              <button type="button" onclick="togglePassword('password_field', this)"
                class="absolute inset-y-0 right-4 flex items-center text-amber-400 hover:text-amber-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>
          <%# Password Confirmation %>
          <div>
            <%= f.label :password_confirmation, class: "block text-sm font-bold text-amber-900 mb-1.5" do %>
              <div class="flex items-center gap-2">
                <div class="w-5 h-5 bg-gradient-to-br from-amber-400 to-orange-500 rounded-md flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                </div>
                Confirm password
              </div>
            <% end %>
            <div class="relative">
              <%= f.password_field :password_confirmation,
                required: true,
                placeholder: "Re-enter your password",
                id: "password_confirmation_field",
                class: "w-full px-4 py-3 pr-12 text-sm text-amber-900 bg-amber-50/60 border border-amber-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all placeholder-amber-300 font-medium" %>
              <button type="button" onclick="togglePassword('password_confirmation_field', this)"
                class="absolute inset-y-0 right-4 flex items-center text-amber-400 hover:text-amber-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>
          <%# Submit %>
          <%= f.submit "Create my account",
            class: "w-full bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 hover:from-amber-600 hover:via-orange-600 hover:to-red-600 active:scale-[0.99] text-white font-black py-3.5 rounded-2xl transition-all duration-200 text-sm cursor-pointer shadow-lg shadow-amber-200 mt-2" %>
        </div>
      <% end %>
      <%# Footer %>
      <div class="px-8 pb-6 text-center">
        <p class="text-xs text-amber-500">
          Already have an account?
          <%= link_to "Sign in", new_session_path, class: "font-bold text-amber-700 hover:text-orange-600 transition-colors" %>
        </p>
      </div>
    </div>
    <%# Tagline %>
    <p class="text-center text-xs text-amber-400 mt-6 font-medium">
      Brewed with love · KAPI Coffee Collection ☕
    </p>
  </div>
</div>
<style>
  @keyframes steamRise {
    0%, 100% { transform: translateY(0) scaleX(1); opacity: 0.7; }
    50% { transform: translateY(-10px) scaleX(1.1); opacity: 0.2; }
  }
  @keyframes floatBean {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-6px) rotate(15deg); }
  }
</style>
<script>
  function togglePassword(fieldId, btn) {
    var field = document.getElementById(fieldId);
    var isHidden = field.type === 'password';
    field.type = isHidden ? 'text' : 'password';
    btn.innerHTML = isHidden
      ? '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>'
      : '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>';
  }
</script>
